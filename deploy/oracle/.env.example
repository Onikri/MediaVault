# Public HTTPS host pointed at the VM. A real domain or <public-ip>.sslip.io works.
SERVER_NAME=replace-with-your-host
ALLOWED_ORIGIN=https://onikri.github.io
GOOGLE_CLIENT_ID=262576202069-9gcrr64crhdubh2drhsspsnq9c0rtfri.apps.googleusercontent.com
# Add ONLY on the private VM. Never commit the completed .env file.
GOOGLE_CLIENT_SECRET=
# One episode at a time. Needs enough disk for that episode, not the whole season.
TMPDIR=/data/temporary
# Optional manga processing. The URL is selected by the operator, never the reader.
LMT_LLM_URL=
LMT_LLM_MODEL=
LMT_LLM_SCHEMA=openai
LMT_LLM_API_KEY=
MANGAJANAI_DEVICE=cpu
MANGAJANAI_MODEL_DIR=/data/mangajanai
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
